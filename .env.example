# Copy this file to .env or set these variables in PowerShell.
# Never commit real API keys.

DEEPSEEK_API_KEY=
THE_ODDS_API_KEY=
ODDS_API_KEY=

# Optional tuning
OFF_FIELD_SEARCH_MODE=deepseek
OFF_FIELD_RECENT_NEWS_DAYS=7
DEEPSEEK_WEB_SEARCH_MAX_USES=4

# The Odds API auto refresh.
# The dashboard/build script refreshes one whole World Cup h2h board when the
# local cache is stale or upcoming fixtures are missing, not once per match.
AUTO_ODDS_API_REFRESH=1
ODDS_API_AUTO_MAX_AGE_SECONDS=21600
ODDS_API_AUTO_HORIZON_DAYS=30
ODDS_API_AUTO_REGIONS=eu
ODDS_API_AUTO_MARKETS=h2h
ODDS_API_AUTO_SPORT_KEY=soccer_fifa_world_cup
